<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileManager.ViewModels"
             xmlns:views="using:FileManager.Views"
             xmlns:conv="using:FileManager.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="FileManager.Views.TabPanelView"
             x:DataType="vm:TabPanelViewModel"
             Focusable="True">

    <DockPanel>
        <!-- Tab strip -->
        <Border DockPanel.Dock="Top" Background="#12ffffff"
                Padding="2,2,2,0"
                BorderBrush="#10ffffff" BorderThickness="0,0,0,1"
                IsVisible="{Binding Tabs.Count}">
            <DockPanel>
                <!-- Add tab button -->
                <Button DockPanel.Dock="Right"
                        Content="+"
                        Command="{Binding AddTabCommand}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#8888aa" FontSize="14" FontWeight="Bold"
                        Padding="8,2" Margin="2,0"
                        MinWidth="0" MinHeight="0"
                        VerticalAlignment="Center"
                        Cursor="Hand" ToolTip.Tip="New Tab (Ctrl+T)" />

                <!-- Tab list using ListBox for selection -->
                <ListBox ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="1,0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Background" Value="#15ffffff" />
                            <Setter Property="CornerRadius" Value="4,4,0,0" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#25ffffff" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1a1a38" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilePanelViewModel">
                            <Grid ColumnDefinitions="*,Auto" MinWidth="60" MaxWidth="180">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding CurrentPath, Converter={x:Static conv:TabNameConverter.Instance}}"
                                           Foreground="#c0c0d8" FontSize="10"
                                           Padding="8,4,4,4"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding CurrentPath}" />
                                <Button Grid.Column="1"
                                        Content="×"
                                        Command="{Binding $parent[views:TabPanelView].((vm:TabPanelViewModel)DataContext).CloseTabCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#666688" FontSize="11"
                                        Padding="4,2" Margin="0"
                                        MinWidth="0" MinHeight="0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Active tab content -->
        <ContentControl Content="{Binding SelectedTab}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:FilePanelViewModel">
                    <views:FilePanelView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </DockPanel>
</UserControl>
